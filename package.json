{
  "name": "shojibrain",
  "version": "1.0.0",
  "description": "Local-first AI codebase intelligence CLI",
  "type": "commonjs",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shojibur/shojibrain.git"
  },
  "homepage": "https://github.com/shojibur/shojibrain#readme",
  "bugs": {
    "url": "https://github.com/shojibur/shojibrain/issues"
  },
  "bin": {
    "shojibrain": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "node dist/index.js",
    "prepublishOnly": "npm run check && npm run build",
    "test": "npm run check"
  },
  "keywords": [
    "cli",
    "codebase-intelligence",
    "developer-tools",
    "typescript"
  ],
  "author": "Shojibur Rahman <shojibur@gmail.com>",
